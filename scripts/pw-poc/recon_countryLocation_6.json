n":"Passport Collection Hours"}],"openingDays":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"target":{"sys":{"id":"4cSTUtufDspdSBQw9uyA66","type":"Link","linkType":"Asset"}}},"content":[{"data":{},"marks":[],"value":"{{ publicholidayslink.text }}","nodeType":"text"}],"nodeType":"asset-hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"thingsYouNeedToKnow":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"{{  attend-centre.essentialinformationbefore  }}","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"callsToAction":[{"sys":{"type":"Link","linkType":"Entry","id":"3AnLc9rgueBKIGLJx757mA"}},{"sys":{"type":"Link","linkType":"Entry","id":"6CWWktXJW8Y3RKHbqCYS8"}},{"sys":{"type":"Link","linkType":"Entry","id":"1599evqbVh8FUbY8VzLiDH"}},{"sys":{"type":"Link","linkType":"Entry","id":"4TTZV6Qup9b5Qxu8h5ZRVr"}}],"securityRegulations":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Please note that access to the Visa Application Centre is restricted to visa applicants only. The only exceptions to this policy are:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Children less than 18 years of age need to be accompanied by a parent or guardian.","marks":[],"data":{}}]}]}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Elderly or disabled applicants or those with medical condition who may require assistance in order to submit their applications should advise the security staff on arrival at the Visa Application Centre.","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Mobile phones are permitted in the Visa Application Centre, but they must be switched to silent mode and put away when you are being served at the counter. Under no circumstances is photography, filming or audio recording permitted inside the Visa application Centre.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Headphones, headsets, earphones, laptops, and tablets may be carried within personal bags but should not be used anywhere within the Visa Application Centre and must be put away when you are dealing with the Visa Application Centre staff.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"For security reasons the following items will not be permitted inside the Visa Application Centre:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"All battery operated or electronic items such cameras, tablets, audio/video cassettes, compact discs, MP3s, floppy disks, laptops, or portable music players, hard disk drive (HDDs), pen/thumb drives, spy devices, audio recorders, or other devices which can hinder the centre’s functioning","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Sealed envelopes or packages.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Any inflammable item such as matchboxes/lighters/electric cigarettes/fuel.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Any sharp objects such as scissors, pen knives or nail filers.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Weapons, weapon-like objects or explosive material of any kind.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Other items may be prohibited based on security staff discretion.","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Please note: The Visa Application Centre is unable to store prohibited items. Applicants should make other arrangements to store these belongings before they enter the Visa Application Centre.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"All Visa Application Centres are under 24 hours CCTV surveillance. The images are constantly recorded for the purposes of crime prevention, detection and public safety.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In the interest of safety and security, we reserve the right to conduct random bag searches of applicants and visitors.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Our staff have the right to work without fear of abuse or intimidation. Threatening or abusive words or behaviour towards our staff will not be tolerated under any circumstances.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In addition to the above mentioned list the followings are also not allowed in the Visa Application Centre:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Bags and personal belongings of applicants, except for small hand bags.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Food and drink items.","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Due to security concerns, friends, relatives or business contacts are not allowed to accompany visa applicants. However, interpreters are allowed to accompany hearing-impaired/physically challenged applicants or applicants who are unable to communicate in any language spoken at the Visa Application Centre.","marks":[],"data":{}}]}]}}},{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"xxg4p8gt3sg6"}},"id":"Vbpg7SO07GlxJLuPnCQ4l","type":"Entry","createdAt":"2021-03-17T15:21:18.005Z","updatedAt":"2026-04-21T10:14:12.337Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":55,"revision":17,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"countryLocation"}},"locale":"en-US"},"fields":{"title":"pol > ind > en > attend-centre > kolkata","isoCode":"CCU","vacName":"Kolkata","intro":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"This Visa Application Centre has an additional fee requirement","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Service fees: {{servicefee2}}","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Paymentmode: {{paymentmode}}","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"location":{"lon":88.3902086,"lat":22.5145594},"googleMapUrl":"https://goo.gl/maps/2uj3xkdfugo4qFUi7?coh=178571&entry=tt","googleMap":"https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3685.7233821626783!2d88.38801991495852!3d22.514559385212717!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMjLCsDMwJzUyLjQiTiA4OMKwMjMnMjQuOCJF!5e0!3m2!1sen!2sin!4v1683964662915!5m2!1sen!2sin","address":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"{{ vacmissiontitle }}\n","nodeTy